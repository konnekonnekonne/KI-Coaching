# Lokale Entwicklung. Werte aus Pipecat Clouds Secret-Set "kico" übernehmen.

# Daily (Transport) — für lokale Tests wird ein Daily-Konto/-Key benötigt,
# selbst wenn die Produktion später auf Pipecat Cloud läuft.
DAILY_API_KEY=

# Deepgram (STT/TTS) — die zwei Stimmen (weiblich/männlich) sind fest in
# voice-agent/models.py hinterlegt, keine env-Variable nötig.
DEEPGRAM_API_KEY=

# Anthropic Claude (LLM) — eigener Key, getrennt vom Netlify-Key
ANTHROPIC_API_KEY=

# Supabase — Transkript-Speicherung, service_role-Key (nicht der anon-Key!)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
