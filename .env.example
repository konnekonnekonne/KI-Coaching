# Supabase-Projekt (Projekteinstellungen → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic-API-Key für den Textmodus (app/api/chat)
ANTHROPIC_API_KEY=

# Public API Key des Pipecat-Cloud-Agenten "kico" (Voice-Modus, app/api/voice/start)
# Nur nötig, wenn der Voice-Agent separat betrieben wird — siehe voice-agent/.env.example
PIPECAT_API_KEY=
